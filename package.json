{
  "name": "discogs-nextjs-viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "dev:worker": "tsx worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:oauth": "RUN_INTERACTIVE=1 playwright test --headed --grep 'full OAuth'"
  },
  "dependencies": {
    "bullmq": "^5.81.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "iron-session": "^8.0.4",
    "next": "^16.2.12",
    "oauth-1.0a": "^2.2.6",
    "p-limit": "4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.12.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "^8.5.10",
      "sharp@<0.35.0": "^0.35.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/dotenv": "^8.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.7",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
